msgid ""
msgstr ""
"Project-Id-Version: GF Bulk Rename Counter 2.2.0\n"
"Language: fa_IR\n"
"Language-Team: GFBRC Phase 1 review candidate\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid " and review %d Entries with no files"
msgstr " و بررسی %d ورودی بدون فایل"

msgid "%1$d Entries / %2$d eligible files / %3$d Entries with no files. "
msgstr "%1$d ورودی / %2$d فایل واجد شرایط / %3$d ورودی بدون فایل. "

msgid "%1$d active Entries / %2$d eligible files / %3$d Entries without files. Entire form; filters, pages, selection and NEW history are ignored."
msgstr "%1$d ورودی فعال / %2$d فایل واجد شرایط / %3$d ورودی بدون فایل. کل فرم بررسی می‌شود و فیلترها، صفحه‌بندی، انتخاب‌ها و سابقهٔ NEW نادیده گرفته می‌شوند."

msgid "%1$s (field %2$d)"
msgstr "%1$s (فیلد %2$d)"

msgid "(none)"
msgstr "(بدون جداکننده)"

msgid "0 newly created eligible Entries / 0 files. Nothing to acknowledge."
msgstr "۰ ورودی جدید واجد شرایط / ۰ فایل. چیزی برای تأیید دریافت وجود ندارد."

msgid "ALL Entries or eligible source files changed before ZIP delivery; check ALL again"
msgstr "ورودی‌های ALL یا فایل‌های مبدأ واجد شرایط پیش از تحویل ZIP تغییر کردند؛ ALL را دوباره بررسی کنید"

msgid "ALL Entries or source files changed; check ALL again"
msgstr "ورودی‌ها یا فایل‌های مبدأ ALL تغییر کرده‌اند؛ ALL را دوباره بررسی کنید"

msgid "ALL Entry enumeration count changed or failed"
msgstr "تعداد ورودی‌های پیمایش‌شدهٔ ALL تغییر کرد یا شمارش ناموفق بود"

msgid "ALL Entry enumeration overflow"
msgstr "تعداد ورودی‌های ALL از محدودهٔ مجاز پیمایش فراتر رفت"

msgid "ALL check could not be completed or verified. Check ALL again before downloading."
msgstr "بررسی ALL کامل نشد یا نتیجهٔ آن قابل‌تأیید نیست. پیش از دانلود، ALL را دوباره بررسی کنید."

msgid "ALL check failed"
msgstr "بررسی ALL ناموفق بود"

msgid "ALL consistent selection snapshot unavailable"
msgstr "تصویر سازگار از انتخاب ALL در دسترس نیست"

msgid "ALL failed: %s — no partial ZIP delivered."
msgstr "عملیات ALL ناموفق بود: %s — هیچ ZIP ناقصی تحویل داده نشد."

msgid "ALL form is unavailable"
msgstr "فرم ALL در دسترس نیست"

msgid "ALL form membership changed during preparation"
msgstr "عضویت ورودی‌های فرم در حین آماده‌سازی ALL تغییر کرد"

msgid "ALL has no eligible files; no empty ZIP was sent"
msgstr "ALL فایل واجد شرایطی ندارد؛ ZIP خالی ارسال نشد"

msgid "ALL includes eligible uploads from every active Entry in this form, regardless of filters, selected rows or NEW acknowledgment history. Check before downloading; this does not advance NEW coverage."
msgstr "ALL فایل‌های بارگذاری‌شدهٔ واجد شرایط همهٔ ورودی‌های فعال این فرم را، مستقل از فیلترها، ردیف‌های انتخاب‌شده و سابقهٔ تأیید دریافت NEW، شامل می‌شود. پیش از دانلود بررسی کنید؛ این کار سابقهٔ پوشش NEW را تغییر نمی‌دهد."

msgid "ALL preview cannot be encoded"
msgstr "امکان رمزگذاری پیش‌نمایش ALL نیست"

msgid "ALL preview expired or form/user changed"
msgstr "پیش‌نمایش ALL منقضی شده یا فرم/کاربر تغییر کرده است"

msgid "ALL preview seal missing or invalid"
msgstr "امضای پیش‌نمایش ALL وجود ندارد یا نامعتبر است"

msgid "ALL requires authenticated Entry viewing permission"
msgstr "ALL به مجوز معتبر مشاهدهٔ ورودی‌ها نیاز دارد"

msgid "ALL requires transactional InnoDB Entry and field storage"
msgstr "ALL به ذخیره‌سازی تراکنشی InnoDB برای ورودی‌ها و فیلدها نیاز دارد"

msgid "ALL selection has duplicate or unsorted Entry IDs"
msgstr "انتخاب ALL شناسه‌های ورودی تکراری یا نامرتب دارد"

msgid "ALL selection incomplete; no partial ZIP"
msgstr "انتخاب ALL ناقص است؛ هیچ ZIP ناقصی ساخته نمی‌شود"

msgid "ALL selection snapshot commit failed"
msgstr "ثبت تراکنش تصویر انتخاب ALL ناموفق بود"

msgid "ALL source size exceeds supported integer range"
msgstr "اندازهٔ منبع ALL از محدودهٔ اعداد صحیح پشتیبانی‌شده فراتر رفت"

msgid "ALL — Download all eligible files"
msgstr "ALL — دانلود همهٔ فایل‌های واجد شرایط"

msgid "ALL: independently check and download eligible files from every active Entry in this form, ignoring search, row selection and NEW history. ALL does not acknowledge NEW."
msgstr "ALL: فایل‌های واجد شرایط همهٔ ورودی‌های فعال فرم را، بدون توجه به جستجو، انتخاب ردیف‌ها و سابقهٔ NEW بررسی و دانلود می‌کند. ALL دریافت NEW را تأیید نمی‌کند."

msgid "All matching Entries (Flat ZIP only; maximum 500)"
msgstr "همهٔ ورودی‌های مطابق فیلتر (فقط ZIP بدون پوشه‌بندی؛ حداکثر ۵۰۰ ورودی)"

msgid "All matching: choose the all-matching checkbox with the independent Bulk Action. It includes the current search and filters across pages (maximum 500 Entries), not just checked rows."
msgstr "همهٔ موارد مطابق فیلتر: در «عملیات گروهی» مستقل، گزینهٔ همهٔ موارد مطابق را انتخاب کنید. جستجو و فیلتر فعلی در تمام صفحات لحاظ می‌شود (حداکثر ۵۰۰ ورودی)، نه فقط ردیف‌های تیک‌خورده."

msgid "Ambiguous ALL form selection"
msgstr "انتخاب فرم ALL مبهم است"

msgid "Ambiguous Entry selection"
msgstr "انتخاب ورودی‌ها مبهم است"

msgid "Ask an administrator to review the naming settings."
msgstr "از مدیر بخواهید تنظیمات نام‌گذاری را بررسی کند."

msgid "Atomic NEW acknowledgment COMMIT failed"
msgstr "ثبت تراکنش اتمی تأیید دریافت NEW ناموفق بود"

msgid "Atomic pending-operation database unavailable"
msgstr "پایگاه داده برای عملیات در انتظارِ اتمی در دسترس نیست"

msgid "Authoritative pending NEW row unavailable"
msgstr "ردیف معتبر عملیات NEW در پایگاه داده در دسترس نیست"

msgid "Avoid personal data in selected fields; missing or unsafe values cause a visible ZIP preparation error."
msgstr "در فیلدهای انتخابی از دادهٔ شخصی استفاده نکنید؛ مقدار ناموجود یا ناامن باعث خطای آشکار در آماده‌سازی ZIP می‌شود."

msgid "Bulk Download Rename Settings"
msgstr "تنظیمات تغییر نام دانلود گروهی"

msgid "Bulk Download deletion metadata unavailable"
msgstr "فرادادهٔ حذف Bulk Download در دسترس نیست"

msgid "Cannot open ZIP for delivery"
msgstr "بازکردن ZIP برای تحویل ممکن نیست"

msgid "Cannot prepare flat ZIP: %s"
msgstr "امکان آماده‌سازی ZIP بدون پوشه‌بندی نیست: %s"

msgid "Cannot read source"
msgstr "امکان خواندن فایل مبدأ نیست"

msgid "Cannot remove output buffer before ZIP response"
msgstr "حذف بافر خروجی پیش از پاسخ ZIP ممکن نیست"

msgid "Cannot resolve ALL: %s"
msgstr "امکان تعیین محدودهٔ ALL نیست: %s"

msgid "Cannot resolve all matching Entries: %s"
msgstr "امکان تعیین همهٔ ورودی‌های مطابق فیلتر نیست: %s"

msgid "Check ALL"
msgstr "بررسی ALL"

msgid "Check NEW"
msgstr "بررسی NEW"

msgid "Check your saved ZIP or explicitly review the zero-file Entries first."
msgstr "ابتدا ZIP ذخیره‌شده را بررسی کنید یا ورودی‌های بدون فایل را صریحاً بازبینی کنید."

msgid "Checking exact Entries and files…"
msgstr "در حال بررسی دقیق ورودی‌ها و فایل‌ها…"

msgid "Checking or downloading never assigns counter values. A missing Legacy counter may intentionally keep an original filename; invalid Single Field / Composite Entry values stop independent ZIP preparation instead."
msgstr "بررسی یا دانلود هرگز شمارهٔ شمارنده اختصاص نمی‌دهد. نبود شمارندهٔ Legacy ممکن است عمداً نام اصلی فایل را حفظ کند؛ اما مقدار نامعتبر ورودی در Single Field یا Composite آماده‌سازی ZIP مستقل را متوقف می‌کند."

msgid "Choose a Single Field"
msgstr "یک فیلد Single Field انتخاب کنید"

msgid "Choose a form to edit"
msgstr "انتخاب فرم برای ویرایش"

msgid "Choose a form to see its effective download naming rule and edit an optional independent override."
msgstr "برای مشاهدهٔ قانون نام‌گذاری مؤثر در دانلود و ویرایش قانون مستقلِ اختیاری، یک فرم انتخاب کنید."

msgid "Closed ZIP unreadable"
msgstr "ZIP بسته‌شده قابل خواندن نیست"

msgid "Composite"
msgstr "Composite (ترکیبی)"

msgid "Composite field no longer exists or is ineligible"
msgstr "فیلد Composite دیگر وجود ندارد یا واجد شرایط نیست"

msgid "Composite field order is invalid"
msgstr "ترتیب فیلدهای Composite نامعتبر است"

msgid "Composite fields and order"
msgstr "فیلدهای Composite و ترتیب آن‌ها"

msgid "Composite fields need unique consecutive order numbers"
msgstr "فیلدهای Composite باید شمارهٔ ترتیب یکتا و پیاپی داشته باشند"

msgid "Composite order must start at 1 without gaps"
msgstr "ترتیب Composite باید بدون فاصله از ۱ شروع شود"

msgid "Composite separator"
msgstr "جداکنندهٔ Composite"

msgid "Concurrent NEW coverage confirmation rejected"
msgstr "تأیید هم‌زمان ثبت در سابقهٔ پوشش NEW رد شد"

msgid "Configuration needs attention before renamed downloads can be expected."
msgstr "تا اصلاح پیکربندی، نباید انتظار دانلود با نام تغییر‌یافته داشت."

msgid "Configure GF Bulk Rename for this form"
msgstr "پیکربندی GF Bulk Rename برای این فرم"

msgid "Configure which form and which field holds the unique counter number. The downloaded files will be renamed to d[COUNTER].extension"
msgstr "فرم و فیلد دارای شمارهٔ شمارندهٔ یکتا را تعیین کنید. نام فایل‌های دانلودی به الگوی d[COUNTER].extension تبدیل می‌شود."

msgid "Confirm receipt and advance NEW"
msgstr "تأیید دریافت و ثبت در سابقهٔ NEW"

msgid "Consistent Entry selection snapshot unavailable"
msgstr "امکان تهیهٔ تصویر سازگار از انتخاب ورودی‌ها نیست"

msgid "Consistent NEW snapshot unavailable"
msgstr "امکان تهیهٔ تصویر سازگار از وضعیت NEW وجود ندارد"

msgid "Counter Field ID"
msgstr "شناسهٔ فیلد شمارنده (Counter Field ID)"

msgid "Counter Field ID %d does not exist on this form. Legacy cannot rename these files; correct the global setting."
msgstr "فیلد شمارنده با شناسهٔ %d در این فرم وجود ندارد. Legacy نمی‌تواند نام این فایل‌ها را تغییر دهد؛ تنظیم عمومی را اصلاح کنید."

msgid "Counting all active Entries and verifying source files…"
msgstr "در حال شمارش همهٔ ورودی‌های فعال و راستی‌آزمایی فایل‌های مبدأ…"

msgid "Deleted URL not present in source Entry"
msgstr "نشانی حذف‌شده در ورودی مبدأ وجود ندارد"

msgid "Download ALL %1$d active Entries / %2$d eligible files / %3$d Entries without files? Filters and NEW history are ignored; NEW acknowledgment does not change."
msgstr "ZIP مربوط به ALL را برای %1$d ورودی فعال، %2$d فایل واجد شرایط و %3$d ورودی بدون فایل دانلود می‌کنید؟ فیلترها و سابقهٔ NEW نادیده گرفته می‌شوند؛ تأیید دریافت NEW تغییر نمی‌کند."

msgid "Download ALL ZIP"
msgstr "دانلود ZIP عملیات ALL"

msgid "Download Flat ZIP with Rename"
msgstr "دانلود ZIP بدون پوشه‌بندی با تغییر نام"

msgid "Download eligible files from %d explicitly checked Entries on this page? File count may differ."
msgstr "فایل‌های واجد شرایط %d ورودی که در همین صفحه صریحاً انتخاب شده‌اند دانلود شوند؟ تعداد فایل‌ها ممکن است متفاوت باشد."

msgid "Download eligible files from ALL %d Entries matching this form and its current filters/search, across every page? Individually checked rows do not limit this choice. Maximum 500 Entries per ZIP; the server rechecks the count before download."
msgstr "فایل‌های واجد شرایط همهٔ %d ورودی مطابق جستجو و فیلترهای فعلی این فرم، در تمام صفحات دانلود شوند؟ ردیف‌های تیک‌خورده این انتخاب را محدود نمی‌کنند. در هر ZIP حداکثر ۵۰۰ ورودی مجاز است و سرور پیش از دانلود تعداد را دوباره بررسی می‌کند."

msgid "Download has not completed in the browser"
msgstr "دانلود در مرورگر کامل نشده است"

msgid "Download verified ZIP"
msgstr "دانلود ZIP راستی‌آزمایی‌شده"

msgid "Downloaded ZIP SHA-256 mismatch"
msgstr "مقدار SHA-256 فایل ZIP دریافت‌شده مطابقت ندارد"

msgid "Downloaded ZIP identity differs from verified operation"
msgstr "هویت ZIP دانلودشده با عملیات راستی‌آزمایی‌شده مطابقت ندارد"

msgid "Duplicate ZIP name"
msgstr "نام تکراری در ZIP"

msgid "Duplicate acknowledgment COMMIT failed"
msgstr "ثبت تراکنش تأیید دریافت تکراری ناموفق بود"

msgid "Duplicate or invalid GFAPI Entry identity"
msgstr "شناسهٔ ورودی GFAPI تکراری یا نامعتبر است"

msgid "Duplicate planned names"
msgstr "نام‌های برنامه‌ریزی‌شده تکراری‌اند"

msgid "Effective Entry List filter criteria changed; reload the list"
msgstr "معیارهای مؤثر فیلتر فهرست ورودی‌ها تغییر کرده‌اند؛ فهرست را بازخوانی کنید"

msgid "Entry List authorization context changed or expired"
msgstr "زمینهٔ مجوز فهرست ورودی‌ها تغییر کرده یا منقضی شده است"

msgid "Entry selection incomplete or empty"
msgstr "انتخاب ورودی‌ها ناقص یا خالی است"

msgid "Entry selection snapshot commit failed"
msgstr "ثبت تراکنش تصویر انتخاب ورودی‌ها ناموفق بود"

msgid "Entry uploads changed before acknowledgment; retry NEW"
msgstr "فایل‌های بارگذاری‌شده پیش از تأیید دریافت تغییر کردند؛ NEW را تکرار کنید"

msgid "Entry uploads changed before atomic acknowledgment"
msgstr "فایل‌های بارگذاری‌شدهٔ ورودی پیش از تأیید اتمی تغییر کردند"

msgid "Exact NEW coverage exceeded safe storage budget"
msgstr "سابقهٔ دقیق پوشش NEW از سقف امن ذخیره‌سازی فراتر رفت"

msgid "Explicit operator confirmation required"
msgstr "تأیید صریح کاربر لازم است"

msgid "Field %d"
msgstr "فیلد %d"

msgid "File URL outside configured upload directories"
msgstr "نشانی فایل خارج از پوشه‌های آپلود پیکربندی‌شده است"

msgid "File downloads and naming"
msgstr "دانلود فایل‌ها و نام‌گذاری"

msgid "File naming settings"
msgstr "تنظیمات نام‌گذاری فایل"

msgid "File-free Entries require a separate explicit review"
msgstr "ورودی‌های بدون فایل به بازبینی صریح و جداگانه نیاز دارند"

msgid "Filenames combine these fields in order: %1$s. Separator: %2$s. Missing or unsafe values stop ZIP preparation."
msgstr "نام فایل‌ها با ترکیب این فیلدها به ترتیب ساخته می‌شود: %1$s. جداکننده: %2$s. مقدار ناموجود یا ناامن آماده‌سازی ZIP را متوقف می‌کند."

msgid "Filenames use %1$s (field %2$d). An empty or unsafe Entry value stops ZIP preparation; it does not silently fall back to the original name."
msgstr "نام فایل از %1$s (فیلد %2$d) گرفته می‌شود. مقدار خالی یا ناامنِ ورودی آماده‌سازی ZIP را متوقف می‌کند و نام اصلی به‌طور پنهانی جایگزین نمی‌شود."

msgid "Files changed since NEW selection; prepare a fresh operation"
msgstr "فایل‌ها پس از انتخاب NEW تغییر کرده‌اند؛ عملیات تازه‌ای آماده کنید"

msgid "First configure a Counter Field ID for Legacy downloads, or select a form below and save an independent Single Field / Composite rule. These are separate settings; saving one does not configure the other."
msgstr "ابتدا برای دانلودهای Legacy شناسهٔ فیلد شمارنده را تنظیم کنید، یا فرمی را در پایین انتخاب و یک قانون مستقل Single Field یا Composite ذخیره کنید. این تنظیمات جدا هستند؛ ذخیرهٔ یکی دیگری را پیکربندی نمی‌کند."

msgid "Flat ZIP download not available"
msgstr "دانلود ZIP بدون پوشه‌بندی در دسترس نیست"

msgid "For Composite, check at least two eligible text/number fields and assign consecutive positions 1, 2, 3 … . Empty Entry values will block ZIP creation."
msgstr "برای Composite دست‌کم دو فیلد متنی/عددی واجد شرایط را انتخاب و جایگاه‌های پیاپی ۱، ۲، ۳ و … تعیین کنید. مقدار خالی در ورودی، ساخت ZIP را متوقف می‌کند."

msgid "Form has too many historical Entries for safe NEW enumeration"
msgstr "تعداد ورودی‌های تاریخی فرم برای پیمایش امن NEW بیش از حد است"

msgid "Form no longer exists"
msgstr "فرم دیگر وجود ندارد"

msgid "Form unavailable"
msgstr "فرم در دسترس نیست"

msgid "Form unavailable."
msgstr "فرم در دسترس نیست."

msgid "GF Bulk Rename"
msgstr "GF Bulk Rename"

msgid "GF Entry ID enumeration failed"
msgstr "پیمایش شناسه‌های ورودی GF ناموفق بود"

msgid "GF Entry identity storage unavailable"
msgstr "ذخیره‌سازی شناسهٔ ورودی GF در دسترس نیست"

msgid "GF upload metadata index inventory unavailable"
msgstr "فهرست ایندکس‌های فرادادهٔ آپلود GF در دسترس نیست"

msgid "GF upload metadata requires a leading Entry identity index"
msgstr "فرادادهٔ آپلود GF به ایندکسی با شناسهٔ ورودی در ابتدای آن نیاز دارد"

msgid "GF upload metadata table unavailable"
msgstr "جدول فرادادهٔ فایل‌های آپلودی GF در دسترس نیست"

msgid "GFAPI Entry enumeration unavailable"
msgstr "امکان فهرست‌کردن ورودی‌ها از طریق GFAPI وجود ندارد"

msgid "GFAPI and stored active Entry snapshot differ"
msgstr "فهرست GFAPI با وضعیت ذخیره‌شدهٔ ورودی‌های فعال تطابق ندارد"

msgid "Generated filename is too long"
msgstr "نام فایل تولیدشده بیش از حد طولانی است"

msgid "Global Legacy Counter Field ID. 0 keeps original names. Set the target form above (or All forms); independent Single Field/Composite overrides are configured separately below."
msgstr "شناسهٔ عمومی فیلد شمارندهٔ Legacy. مقدار ۰ نام اصلی فایل‌ها را حفظ می‌کند. فرم هدف را در بالا تعیین کنید (یا همهٔ فرم‌ها را انتخاب کنید)؛ قوانین مستقل Single Field/Composite جداگانه در پایین پیکربندی می‌شوند."

msgid "Gravity Forms Bulk Rename Counter requires \"Bulk Download for Gravity Forms\" plugin to be installed and active."
msgstr "افزونهٔ Gravity Forms Bulk Rename Counter به نصب و فعال‌بودن افزونهٔ «Bulk Download for Gravity Forms» نیاز دارد."

msgid "Gravity Forms Bulk Rename Counter requires Gravity Forms to be installed and active."
msgstr "افزونهٔ Gravity Forms Bulk Rename Counter به نصب و فعال‌بودن Gravity Forms نیاز دارد."

msgid "Gravity Forms Bulk Rename Settings"
msgstr "تنظیمات Gravity Forms Bulk Rename"

msgid "Gravity Forms deletion metadata cache unavailable"
msgstr "حافظهٔ موقت فرادادهٔ حذف Gravity Forms در دسترس نیست"

msgid "Gravity Forms transactional Entry storage unavailable"
msgstr "ذخیره‌سازی تراکنشی ورودی‌های Gravity Forms در دسترس نیست"

msgid "Headers sent during output buffer cleanup"
msgstr "سرآیندها هنگام پاک‌سازی بافر خروجی ارسال شدند"

msgid "I saved and checked the ZIP (or reviewed the zero-file Entries)"
msgstr "من ZIP را ذخیره و بررسی کرده‌ام (یا ورودی‌های بدون فایل را بازبینی کرده‌ام)"

msgid "Inconsistent deleted-file flag and URL list"
msgstr "پرچم حذف فایل با فهرست نشانی‌های آن سازگار نیست"

msgid "Independent ZIP: Composite"
msgstr "ZIP مستقل: Composite (ترکیبی)"

msgid "Independent ZIP: Single Field"
msgstr "ZIP مستقل: Single Field (تک‌فیلدی)"

msgid "Independent ZIP: explicit Legacy rule"
msgstr "ZIP مستقل: قانون صریح Legacy"

